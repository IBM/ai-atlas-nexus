skos:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ owl:unionOf ( nexus:CapabilityConcept airo:RiskConcept ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( dpv:Country dpv:SupraNationalUnion dpv:Region ) ] ;
            owl:onProperty dpv:hasJurisdiction ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dpv:hasJurisdiction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        <http://schema.org/Thing> ;
    skos:definition "A concept" ;
    skos:exactMatch nexus:Concept ;
    skos:inScheme nexus:common .

