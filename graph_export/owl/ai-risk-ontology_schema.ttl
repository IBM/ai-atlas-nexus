            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:License ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://schema.org/version> ],
        [ owl:unionOf ( nexus:AiTaskTaxonomy skos:ConceptScheme nexus:RiskControlGroupTaxonomy nexus:RiskTaxonomy ) ],
