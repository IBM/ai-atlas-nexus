            owl:onProperty nexus:hasMetricConfig ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:sourcedata ;
            owl:onProperty nexus:hasSourceData ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:scoredetails ;
            owl:onProperty nexus:hasScoreDetails ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasMetricConfig ],
        <http://schema.org/Thing> ;
