@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix adms-status: <http://purl.org/adms/status/> .
@prefix ai: <https://w3id.org/dpv/ai#> .
@prefix airo: <https://w3id.org/airo#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix dpv-risk: <https://w3id.org/dpv/risk#> .
@prefix dqv: <https://www.w3.org/TR/vocab-dqv/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix nexus: <https://w3id.org/ai-atlas-nexus/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix pso: <http://purl.org/spar/pso/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tech: <https://w3id.org/dpv/tech#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nexus:Container a owl:Class ;
    rdfs:label "Container" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dpv:Permission ;
            owl:onProperty nexus:permissions ],
        [ a owl:Restriction ;
            owl:allValuesFrom dpv:Policy ;
            owl:onProperty nexus:policies ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Modality ;
            owl:onProperty nexus:modalities ],
        [ a owl:Restriction ;
            owl:allValuesFrom dpv:Rule ;
            owl:onProperty nexus:rules ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:taxonomies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:benchmarkmetadatacards ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AiCapability ;
            owl:onProperty nexus:aitasks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:organizations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:stakeholders ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:aievalresults ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Stakeholder ;
            owl:onProperty nexus:stakeholders ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty nexus:taxonomies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:aitasks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:modalities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:obligations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:aimodelfamilies ],
        [ a owl:Restriction ;
            owl:allValuesFrom dpv-risk:Incident ;
            owl:onProperty nexus:riskincidents ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:prohibitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqv:QualityMeasurement ;
            owl:onProperty nexus:aievalresults ],
        [ a owl:Restriction ;
            owl:allValuesFrom dpv:Prohibition ;
            owl:onProperty nexus:prohibitions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:benchmarkmetadatacard ;
            owl:onProperty nexus:benchmarkmetadatacards ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:licenses ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://schema.org/Organization> ;
            owl:onProperty nexus:organizations ],
        [ a owl:Restriction ;
            owl:allValuesFrom ai:Capability ;
            owl:onProperty nexus:llmintrinsics ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty nexus:vocabularies ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:LargeLanguageModelFamily ;
            owl:onProperty nexus:aimodelfamilies ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:Action ;
            owl:onProperty nexus:actions ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:StakeholderGroup ;
            owl:onProperty nexus:stakeholdergroups ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:policies ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Collection ;
            owl:onProperty nexus:groups ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:concepts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:actions ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty nexus:concepts ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:Entry ;
            owl:onProperty nexus:entries ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:evaluations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:aimodels ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:Control ;
            owl:onProperty nexus:controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom dpv:Obligation ;
            owl:onProperty nexus:obligations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:groups ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty nexus:documents ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:adapters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:documents ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:riskincidents ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqv:Metric ;
            owl:onProperty nexus:evaluations ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://schema.org/Dataset> ;
            owl:onProperty nexus:datasets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:rules ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:License ;
            owl:onProperty nexus:licenses ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:llmintrinsics ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:LargeLanguageModel ;
            owl:onProperty nexus:aimodels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:entries ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:stakeholdergroups ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:datasets ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:Adapter ;
            owl:onProperty nexus:adapters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:vocabularies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:permissions ] ;
    skos:definition "An umbrella object that holds the ontology class instances" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:Questionnaire a owl:Class ;
    rdfs:label "Questionnaire" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:isComposedOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:Question ;
            owl:onProperty nexus:isComposedOf ],
        dqv:Metric ;
    skos:definition "A questionnaire groups questions" ;
    skos:inScheme nexus:ai_eval .

nexus:ai-risk-ontology.owl.ttl a owl:Ontology ;
    rdfs:label "ai-risk-ontology" ;
    dcterms:license "https://www.apache.org/licenses/LICENSE-2.0.html" ;
    pav:version "0.5.0" ;
    skos:definition "An ontology describing AI systems and their risks" .

nexus:appliesToCapability a owl:DatatypeProperty ;
    rdfs:label "appliesToCapability" ;
    skos:inScheme nexus:ai_aiuc .

nexus:hasTerm a owl:ObjectProperty ;
    rdfs:label "hasTerm" ;
    rdfs:range nexus:Term ;
    skos:definition "Indicates terms associated with a vocabulary" ;
    skos:inScheme nexus:common .

nexus:hasTrainingDataPreprocessing a owl:ObjectProperty ;
    rdfs:label "hasTrainingDataPreprocessing" ;
    rdfs:range nexus:DataPreprocessing ;
    skos:definition "Relationship indicating data preprocessing steps performed on training data sets to ensure high quality training data." ;
    skos:inScheme nexus:ai_system .

nexus:implementedByIntrinsic a owl:ObjectProperty ;
    rdfs:label "implementedByIntrinsic" ;
    rdfs:domain linkml:Any ;
    rdfs:range linkml:Any ;
    owl:inverseOf nexus:implementsCapability ;
    skos:definition "Indicates that this capability is implemented by a specific LLM intrinsic. This relationship distinguishes the abstract capability (what can be done) from the technical implementation mechanism (how it is done at the model component level)." ;
    skos:inScheme nexus:common .

nexus:isDistributedBy a owl:ObjectProperty ;
    rdfs:label "isDistributedBy" ;
    rdfs:range <http://schema.org/Organization> ;
    skos:definition "A relationship indicating that an entity has been distributed by an organization." ;
    skos:inScheme nexus:eu_ai_act .

nexus:isImportedBy a owl:ObjectProperty ;
    rdfs:label "isImportedBy" ;
    rdfs:range <http://schema.org/Organization> ;
    skos:definition "A relationship indicating that an entity has been imported by an organization." ;
    skos:inScheme nexus:eu_ai_act .

nexus:isValidatedBy a owl:ObjectProperty ;
    rdfs:label "isValidatedBy" ;
    rdfs:range nexus:AiModelValidation ;
    skos:definition "A relationship indicating the model validation steps after AI model training." ;
    skos:inScheme nexus:ai_system .

nexus:producer a owl:DatatypeProperty ;
    rdfs:label "producer" ;
    skos:inScheme nexus:common .

nexus:provider a owl:DatatypeProperty ;
    rdfs:label "provider" ;
    skos:inScheme nexus:common .

nexus:training_data_preprocessing a owl:DatatypeProperty ;
    rdfs:label "training_data_preprocessing" ;
    skos:inScheme nexus:ai_system .

airo:isUsedBy a owl:ObjectProperty ;
    rdfs:label "isUsedBy" ;
    rdfs:range airo:AIProvider ;
    skos:definition "Indicates user of an AI system." ;
    skos:inScheme nexus:ai_system .

dpv:IncidentConcludedclass a owl:Class ;
    rdfs:label "IncidentConcludedclass" ;
    rdfs:subClassOf dpv:IncidentStatus ;
    skos:exactMatch nexus:IncidentConcludedclass ;
    skos:inScheme nexus:ai_risk .

dpv:IncidentHaltedclass a owl:Class ;
    rdfs:label "IncidentHaltedclass" ;
    rdfs:subClassOf dpv:IncidentStatus ;
    skos:exactMatch nexus:IncidentHaltedclass ;
    skos:inScheme nexus:ai_risk .

dpv:IncidentMitigatedclass a owl:Class ;
    rdfs:label "IncidentMitigatedclass" ;
    rdfs:subClassOf dpv:IncidentStatus ;
    skos:exactMatch nexus:IncidentMitigatedclass ;
    skos:inScheme nexus:ai_risk .

dpv:IncidentNearMissclass a owl:Class ;
    rdfs:label "IncidentNearMissclass" ;
    rdfs:subClassOf dpv:IncidentStatus ;
    skos:exactMatch nexus:IncidentNearMissclass ;
    skos:inScheme nexus:ai_risk .

dpv:IncidentOngoingclass a owl:Class ;
    rdfs:label "IncidentOngoingclass" ;
    rdfs:subClassOf dpv:IncidentStatus ;
    skos:exactMatch nexus:IncidentOngoingclass ;
    skos:inScheme nexus:ai_risk .

adms-status:Completed a skos:Concept ;
    rdfs:label "APPROVED" ;
    dcterms:isPartOf nexus:LifecycleStatus ;
    skos:definition "Approved / published as authoritative." .

adms-status:UnderDevelopment a skos:Concept ;
    rdfs:label "DRAFT" ;
    dcterms:isPartOf nexus:LifecycleStatus ;
    skos:definition "Initial draft under development." .

adms-status:Withdrawn a skos:Concept ;
    rdfs:label "WITHDRAWN" ;
    dcterms:isPartOf nexus:LifecycleStatus ;
    skos:definition "Removed / no longer available." .

pso:under-review a skos:Concept ;
    rdfs:label "REVIEW" ;
    dcterms:isPartOf nexus:LifecycleStatus ;
    skos:definition "Under editorial or technical review." ;
    skos:note "No ADMS equivalent. PSO covers peer review which is sufficient." .

<http://schema.org/Statement> a owl:Class ;
    rdfs:label "Fact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:evidence ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nexus:value ] ;
    skos:definition "A fact about something, for example the result of a measurement. In addition to the value, evidence is provided." ;
    skos:exactMatch nexus:Fact ;
    skos:inScheme nexus:common .

<https://w3id.org/ai-atlas-nexus/AIUC1ApplicationCategory#MANDATORY> a skos:Concept ;
    rdfs:label "MANDATORY" ;
    dcterms:isPartOf nexus:AIUC1ApplicationCategory ;
    skos:definition "Mandatory" .

<https://w3id.org/ai-atlas-nexus/AIUC1ApplicationCategory#OPTIONAL> a skos:Concept ;
    rdfs:label "OPTIONAL" ;
    dcterms:isPartOf nexus:AIUC1ApplicationCategory ;
    skos:definition "Optional" .

<https://w3id.org/ai-atlas-nexus/AIUC1ControlApplicationCategory#CORE> a skos:Concept ;
    rdfs:label "CORE" ;
    dcterms:isPartOf nexus:AIUC1ControlApplicationCategory ;
    skos:definition "Core Control" .

<https://w3id.org/ai-atlas-nexus/AIUC1ControlApplicationCategory#SUPPLEMENTAL> a skos:Concept ;
    rdfs:label "SUPPLEMENTAL" ;
    dcterms:isPartOf nexus:AIUC1ControlApplicationCategory ;
    skos:definition "Supplemental Control" .

<https://w3id.org/ai-atlas-nexus/AIUC1EvidenceCategory#LEGAL_POLICIES> a skos:Concept ;
    rdfs:label "LEGAL_POLICIES" ;
    dcterms:isPartOf nexus:AIUC1EvidenceCategory ;
    skos:definition "Legal Policies" .

<https://w3id.org/ai-atlas-nexus/AIUC1EvidenceCategory#OPERATIONAL_PRACTICES> a skos:Concept ;
    rdfs:label "OPERATIONAL_PRACTICES" ;
    dcterms:isPartOf nexus:AIUC1EvidenceCategory ;
    skos:definition "Operational Practices" .

<https://w3id.org/ai-atlas-nexus/AIUC1EvidenceCategory#TECHNICAL_IMPLEMENTATION> a skos:Concept ;
    rdfs:label "TECHNICAL_IMPLEMENTATION" ;
    dcterms:isPartOf nexus:AIUC1EvidenceCategory ;
    skos:definition "Technical Implementation" .

<https://w3id.org/ai-atlas-nexus/AIUC1EvidenceCategory#THIRD_PARTY_EVALS> a skos:Concept ;
    rdfs:label "THIRD_PARTY_EVALS" ;
    dcterms:isPartOf nexus:AIUC1EvidenceCategory ;
    skos:definition "Third-party Evals" .

<https://w3id.org/ai-atlas-nexus/AIUC1Frequency#MONTHS_12> a skos:Concept ;
    rdfs:label "MONTHS_12" ;
    dcterms:isPartOf nexus:AIUC1Frequency ;
    skos:definition "Every 12 months" .

<https://w3id.org/ai-atlas-nexus/AIUC1Frequency#MONTHS_3> a skos:Concept ;
    rdfs:label "MONTHS_3" ;
    dcterms:isPartOf nexus:AIUC1Frequency ;
    skos:definition "Every 3 months" .

<https://w3id.org/ai-atlas-nexus/AIUC1Frequency#MONTHS_6> a skos:Concept ;
    rdfs:label "MONTHS_6" ;
    dcterms:isPartOf nexus:AIUC1Frequency ;
    skos:definition "Every 6 months" .

<https://w3id.org/ai-atlas-nexus/AIUC1RequirementType#DETECTIVE> a skos:Concept ;
    rdfs:label "DETECTIVE" ;
    dcterms:isPartOf nexus:AIUC1RequirementType ;
    skos:definition "Detective" .

<https://w3id.org/ai-atlas-nexus/AIUC1RequirementType#PREVENTATIVE> a skos:Concept ;
    rdfs:label "PREVENTATIVE" ;
    dcterms:isPartOf nexus:AIUC1RequirementType ;
    skos:definition "Preventative" .

<https://w3id.org/ai-atlas-nexus/AdapterType#ALORA> a skos:Concept ;
    rdfs:label "ALORA" ;
    dcterms:isPartOf nexus:AdapterType ;
    skos:definition "Activated LoRA (aLoRA) is a low rank adapter architecture that allows for reusing existing base model KV cache for more efficient inference, unlike standard LoRA models. As a result, aLoRA models can be quickly invoked as-needed for specialized tasks during (long) flows where the base model is primarily used, avoiding potentially expensive prefill costs in terms of latency, throughput, and GPU memory. See arXiv:2504.12397 for further details." .

<https://w3id.org/ai-atlas-nexus/AdapterType#LORA> a skos:Concept ;
    rdfs:label "LORA" ;
    dcterms:isPartOf nexus:AdapterType ;
    skos:definition "Low-rank adapters, or LoRAs, are a fast way to give generalist large language models targeted knowledge and skills so they can do things like summarize IT manuals or rate the accuracy of their own answers. LoRA reduces the number of trainable parameters by learning pairs of rank-decompostion matrices while freezing the original weights. This vastly reduces the storage requirement for large language models adapted to specific tasks and enables efficient task-switching during deployment all without introducing inference latency. LoRA also outperforms several other adaptation methods including adapter, prefix-tuning, and fine-tuning. See arXiv:2106.09685" .

<https://w3id.org/ai-atlas-nexus/AdapterType#X-LORA> a skos:Concept ;
    rdfs:label "X-LORA" ;
    dcterms:isPartOf nexus:AdapterType ;
    skos:definition "Mixture of LoRA Experts (X-LoRA) is a mixture of experts method for LoRA which works by using dense or sparse gating to dynamically activate LoRA experts." .

<https://w3id.org/ai-atlas-nexus/AiSystemType#GPAI> a skos:Concept ;
    rdfs:label "GPAI" ;
    dcterms:isPartOf nexus:AiSystemType ;
    skos:definition "General-purpose AI (GPAI)" .

<https://w3id.org/ai-atlas-nexus/AiSystemType#GPAI_OS> a skos:Concept ;
    rdfs:label "GPAI_OS" ;
    dcterms:isPartOf nexus:AiSystemType ;
    skos:definition "General-purpose AI (GPAI) models released under free and open-source licences" .

<https://w3id.org/ai-atlas-nexus/AiSystemType#HIGH_RISK> a skos:Concept ;
    rdfs:label "HIGH_RISK" ;
    dcterms:isPartOf nexus:AiSystemType ;
    skos:definition "AI systems pursuant to Article 6(1)(2) Classification Rules for High-Risk AI Systems" .

<https://w3id.org/ai-atlas-nexus/AiSystemType#MILITARY_SECURITY> a skos:Concept ;
    rdfs:label "MILITARY_SECURITY" ;
    dcterms:isPartOf nexus:AiSystemType ;
    skos:definition "AI used for military, defense and security purposes." .

<https://w3id.org/ai-atlas-nexus/AiSystemType#PROHIBITED> a skos:Concept ;
    rdfs:label "PROHIBITED" ;
    dcterms:isPartOf nexus:AiSystemType ;
    skos:definition "Prohibited AI system due to unacceptable risk category (e.g. social scoring systems and manipulative AI)." .

<https://w3id.org/ai-atlas-nexus/AiSystemType#SCIENTIFIC_RD> a skos:Concept ;
    rdfs:label "SCIENTIFIC_RD" ;
    dcterms:isPartOf nexus:AiSystemType ;
    skos:definition "AI used for scientific research and development" .

<https://w3id.org/ai-atlas-nexus/EuAiRiskCategory#EXCLUDED> a skos:Concept ;
    rdfs:label "EXCLUDED" ;
    dcterms:isPartOf nexus:EuAiRiskCategory ;
    skos:definition "Excluded" .

<https://w3id.org/ai-atlas-nexus/EuAiRiskCategory#HIGH_RISK> a skos:Concept ;
    rdfs:label "HIGH_RISK" ;
    dcterms:isPartOf nexus:EuAiRiskCategory ;
    skos:definition "High Risk" .

<https://w3id.org/ai-atlas-nexus/EuAiRiskCategory#HIGH_RISK_EXCEPTION> a skos:Concept ;
    rdfs:label "HIGH_RISK_EXCEPTION" ;
    dcterms:isPartOf nexus:EuAiRiskCategory ;
    skos:definition "High-Risk Exception" .

<https://w3id.org/ai-atlas-nexus/EuAiRiskCategory#LIMITED_OR_LOW_RISK> a skos:Concept ;
    rdfs:label "LIMITED_OR_LOW_RISK" ;
    dcterms:isPartOf nexus:EuAiRiskCategory ;
    skos:definition "Limited or Low Risk" .

<https://w3id.org/ai-atlas-nexus/EuAiRiskCategory#PROHIBITED> a skos:Concept ;
    rdfs:label "PROHIBITED" ;
    dcterms:isPartOf nexus:EuAiRiskCategory ;
    skos:definition "Prohibited" .

<https://w3id.org/ai-atlas-nexus/LifecycleStatus#SUPERSEDED> a skos:Concept ;
    rdfs:label "SUPERSEDED" ;
    dcterms:isPartOf nexus:LifecycleStatus ;
    skos:closeMatch adms-status:Deprecated ;
    skos:definition "Replaced by a newer version of this entity." ;
    skos:editorialNote "Mapped as close_mappings, not meaning. ADMS collapses supersession into Deprecated, which is already the exact meaning of DEPRECATED, and two values sharing one meaning URI would be indistinguishable in RDF." ;
    skos:note "Neither ADMS nor PSO defines a supersession status, so this value is minted in the nexus namespace rather than aligned to an external vocabulary." .

nexus:Question a owl:Class ;
    rdfs:label "Question" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:text ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nexus:text ],
        dqv:Metric ;
    skos:definition "An evaluation where a question has to be answered" ;
    skos:inScheme nexus:ai_eval .

nexus:SlotCondition a owl:Class ;
    rdfs:label "SlotCondition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:slot_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:equals_string ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:slot_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:slot_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:equals_string ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:equals_string ] ;
    skos:inScheme nexus:common .

<https://w3id.org/ai-atlas-nexus/SupraNationalJurisdiction#International> a skos:Concept ;
    rdfs:label "International" ;
    dcterms:isPartOf nexus:SupraNationalJurisdiction ;
    skos:altLabel "INTERNATIONAL",
        "international" ;
    skos:definition "Explicitly global scope not attributable to any single country or recognised regional body." .

nexus:evaluatedByBenchmark a owl:ObjectProperty ;
    rdfs:label "evaluatedByBenchmark" ;
    rdfs:range nexus:benchmarkmetadatacard ;
    owl:inverseOf nexus:evaluatesCapability ;
    skos:definition "Indicates that this capability is evaluated by a specific benchmark" ;
    skos:inScheme nexus:ai_capability .

nexus:evaluatesCapability a owl:ObjectProperty ;
    rdfs:label "evaluatesCapability" ;
    rdfs:domain nexus:benchmarkmetadatacard ;
    rdfs:range ai:Capability ;
    owl:inverseOf nexus:evaluatedByBenchmark ;
    skos:definition "Indicates that this benchmark evaluates a specific capability" ;
    skos:inScheme nexus:ai_capability .

airo:AIOperator a owl:Class ;
    rdfs:label "AIOperator" ;
    rdfs:subClassOf airo:Stakeholder ;
    skos:definition "Refers to a provider, product manufacturer, deployer, authorised representative, importer or distributor." ;
    skos:exactMatch nexus:AIOperator ;
    skos:inScheme nexus:ai_system .

airo:Input a owl:Class ;
    rdfs:label "Input" ;
    rdfs:subClassOf <http://schema.org/Thing> ;
    skos:definition "Input for which the system or component generates output." ;
    skos:exactMatch nexus:Input ;
    skos:inScheme nexus:ai_system .

adms-status:Deprecated a skos:Concept ;
    rdfs:label "DEPRECATED" ;
    dcterms:isPartOf nexus:LifecycleStatus ;
    skos:definition "Discouraged for new use but still available." .

skos:broadMatch a owl:ObjectProperty ;
    rdfs:label "broad_mappings" ;
    rdfs:range linkml:Any ;
    skos:definition "The property is used to state a hierarchical mapping link between two concepts, indicating that the concept linked to, is a broader concept than the originating concept." ;
    skos:inScheme nexus:common .

skos:closeMatch a owl:ObjectProperty ;
    rdfs:label "close_mappings" ;
    rdfs:range linkml:Any ;
    skos:definition "The property is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications." ;
    skos:inScheme nexus:common .

skos:exactMatch a owl:ObjectProperty ;
    rdfs:label "exact_mappings" ;
    rdfs:range linkml:Any ;
    skos:definition "The property is used to link two concepts, indicating a high degree of confidence that the concepts can be used interchangeably across a wide range of information retrieval applications" ;
    skos:inScheme nexus:common .

skos:narrowMatch a owl:ObjectProperty ;
    rdfs:label "narrow_mappings" ;
    rdfs:range linkml:Any ;
    skos:definition "The property is used to state a hierarchical mapping link between two concepts, indicating that the concept linked to, is a narrower concept than the originating concept." ;
    skos:inScheme nexus:common .

skos:note a owl:DatatypeProperty ;
    rdfs:label "notes" ;
    skos:definition "Free-text editorial notes, source breadcrumbs, or build-time provenance that do not belong in the user-facing description. Opaque to consumers." ;
    skos:inScheme nexus:common .

skos:relatedMatch a owl:ObjectProperty ;
    rdfs:label "related_mappings" ;
    rdfs:range linkml:Any ;
    skos:definition "The property skos:relatedMatch is used to state an associative mapping link between two concepts." ;
    skos:inScheme nexus:common .

nexus:AiAgent a owl:Class ;
    rdfs:label "AiAgent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:isProvidedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty nexus:isProvidedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:isProvidedBy ],
        airo:AISystem ;
    skos:definition "An artificial intelligence (AI) agent refers to a system or program that is capable of autonomously performing tasks on behalf of a user or another system by designing its workflow and utilizing available tools." ;
    skos:inScheme nexus:ai_system .

nexus:AiModel a owl:Class ;
    rdfs:label "AiModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:carbon_emitted ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqv:QualityMeasurement ;
            owl:onProperty dqv:hasQualityMeasurement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:architecture ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:gpu_hours ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasRiskControl ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty nexus:gpu_hours ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty nexus:power_consumption_w ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:power_consumption_w ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty nexus:carbon_emitted ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:RiskControl ;
            owl:onProperty airo:hasRiskControl ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:architecture ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqv:hasQualityMeasurement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:gpu_hours ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:carbon_emitted ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:architecture ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:power_consumption_w ],
        nexus:BaseAi,
        airo:AIComponent ;
    skos:definition "A base AI Model class. No assumption about the type (SVM, LLM, etc.). Subclassed by model types (see LargeLanguageModel)." ;
    skos:inScheme nexus:ai_system .

nexus:AiModelValidation a owl:Class ;
    rdfs:label "AiModelValidation" ;
    rdfs:subClassOf airo:AILifecyclePhase ;
    skos:definition "AI model validation steps that have been performed after the model training to ensure high AI model quality." ;
    skos:inScheme nexus:ai_system .

nexus:AnonymousClassExpression a owl:Class ;
    rdfs:label "AnonymousClassExpression" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nexus:SlotCondition ;
            owl:onProperty nexus:slot_conditions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:slot_conditions ] ;
    skos:inScheme nexus:common .

nexus:DataPreprocessing a owl:Class ;
    rdfs:label "DataPreprocessing" ;
    rdfs:subClassOf airo:AILifecyclePhase ;
    skos:definition "Data transformations, such as PI filtering, performed to ensure high quality of AI model training data." ;
    skos:inScheme nexus:ai_system .

nexus:Jurisdiction a owl:Class ;
    rdfs:label "Jurisdiction" ;
    skos:definition "ISO 3166-1 country code, sourced from the DPV Location ontology (https://w3id.org/dpv/loc). Values are subclasses of dpv:Country." ;
    skos:inScheme nexus:common .

nexus:SubnationalJurisdiction a owl:Class ;
    rdfs:label "SubnationalJurisdiction" ;
    skos:definition "Subnational or regional jurisdiction, sourced from the DPV Location ontology (https://w3id.org/dpv/loc). Values are subclasses of dpv:Region and use ISO 3166-2 subdivision codes (e.g. US-CA for California, CA-QC for Quebec)." ;
    skos:inScheme nexus:common .

nexus:actions a owl:ObjectProperty ;
    rdfs:label "actions" ;
    skos:definition "A list of risk related actions" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:adapters a owl:ObjectProperty ;
    rdfs:label "adapters" ;
    skos:definition "A list of Adapters" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:adaptsModel a owl:ObjectProperty ;
    rdfs:label "adaptsModel" ;
    rdfs:range nexus:LargeLanguageModel ;
    skos:definition "The LargeLanguageModel being adapted" ;
    skos:inScheme nexus:ai_intrinsic .

nexus:aievalresults a owl:ObjectProperty ;
    rdfs:label "aievalresults" ;
    skos:definition "A list of AI evaluation results" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:aimodelfamilies a owl:ObjectProperty ;
    rdfs:label "aimodelfamilies" ;
    skos:definition "A list of AI model families" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:aimodels a owl:ObjectProperty ;
    rdfs:label "aimodels" ;
    skos:definition "A list of AI models" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:aitasks a owl:ObjectProperty ;
    rdfs:label "aitasks" ;
    skos:definition "A list of AI tasks" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:benchmarkmetadatacards a owl:ObjectProperty ;
    rdfs:label "benchmarkmetadatacards" ;
    skos:definition "A list of AI evaluation benchmark metadata cards" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:concepts a owl:ObjectProperty ;
    rdfs:label "concepts" ;
    skos:definition "A list of concepts" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:controls a owl:ObjectProperty ;
    rdfs:label "controls" ;
    skos:definition "A list of AI controls" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:datasets a owl:ObjectProperty ;
    rdfs:label "datasets" ;
    skos:definition "A list of data sets" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:descriptor a owl:DatatypeProperty ;
    rdfs:label "descriptor" ;
    skos:definition "Annotates whether an AI risk is a traditional risk, specific to or amplified by AI." ;
    skos:inScheme nexus:ai_risk .

nexus:documents a owl:ObjectProperty ;
    rdfs:label "documents" ;
    skos:definition "A list of documents" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:entries a owl:ObjectProperty ;
    rdfs:label "entries" ;
    skos:definition "A list of entries" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:evaluations a owl:ObjectProperty ;
    rdfs:label "evaluations" ;
    skos:definition "A list of AI evaluation methods" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:groups a owl:ObjectProperty ;
    rdfs:label "groups" ;
    skos:definition "A list of groups" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:hasAdapter a owl:ObjectProperty ;
    rdfs:label "hasAdapter" ;
    rdfs:domain ai:Capability ;
    rdfs:range nexus:Adapter ;
    skos:definition "The Adapter for the intrinsic" ;
    skos:inScheme nexus:ai_intrinsic .

nexus:hasAdapterType a owl:ObjectProperty ;
    rdfs:label "hasAdapterType" ;
    rdfs:range nexus:AdapterType ;
    skos:definition "The Adapter type, for example: LORA, ALORA, X-LORA" ;
    skos:inScheme nexus:ai_intrinsic .

nexus:hasAiActorTask a owl:DatatypeProperty ;
    rdfs:label "hasAiActorTask" ;
    skos:definition "Pertinent AI Actor Tasks for each subcategory. Not every AI Actor Task listed will apply to every suggested action in the subcategory (i.e., some apply to AI development and others apply to AI deployment)." ;
    skos:inScheme nexus:ai_risk .

nexus:hasAnnotation a owl:DatatypeProperty ;
    rdfs:label "hasAnnotation" ;
    skos:definition "The process used to annotate or label the dataset, including who or what performed the annotations (e.g., human annotators, automated processes)." ;
    skos:inScheme nexus:ai_eval .

nexus:hasApplication a owl:ObjectProperty ;
    rdfs:label "hasApplication" ;
    rdfs:domain nexus:Requirement ;
    rdfs:range nexus:AIUC1ApplicationCategory ;
    skos:definition "The application category, Optional or Mandatory." ;
    skos:inScheme nexus:ai_aiuc .

nexus:hasBaselineResults a owl:DatatypeProperty ;
    rdfs:label "hasBaselineResults" ;
    skos:definition "The results of well-known or widely used models to give context to new performance scores." ;
    skos:inScheme nexus:ai_eval .

nexus:hasCalculation a owl:DatatypeProperty ;
    rdfs:label "hasCalculation" ;
    skos:definition "The way metrics are computed based on model outputs and the benchmark data." ;
    skos:inScheme nexus:ai_eval .

nexus:hasConsiderationComplianceWithRegulations a owl:DatatypeProperty ;
    rdfs:label "hasConsiderationComplianceWithRegulations" ;
    skos:definition "Compliance with relevant legal or ethical regulations (if applicable)." ;
    skos:inScheme nexus:ai_eval .

nexus:hasConsiderationConsentProcedures a owl:DatatypeProperty ;
    rdfs:label "hasConsiderationConsentProcedures" ;
    skos:definition "Information on how consent was obtained (if applicable), especially for datasets involving personal data." ;
    skos:inScheme nexus:ai_eval .

nexus:hasConsiderationPrivacyAndAnonymity a owl:DatatypeProperty ;
    rdfs:label "hasConsiderationPrivacyAndAnonymity" ;
    skos:definition "How any personal or sensitive data is handled and whether any anonymization techniques are applied." ;
    skos:inScheme nexus:ai_eval .

nexus:hasDataset a owl:ObjectProperty ;
    rdfs:label "hasDataset" ;
    rdfs:range <http://schema.org/Dataset> ;
    skos:definition "A relationship to datasets that are used." ;
    skos:inScheme nexus:common .

nexus:hasDemographicAnalysis a owl:DatatypeProperty ;
    rdfs:label "hasDemographicAnalysis" ;
    skos:definition "How the benchmark evaluates performance across different demographic groups (e.g., gender, race)." ;
    skos:inScheme nexus:ai_eval .

nexus:hasEvaluationResults a owl:ObjectProperty ;
    rdfs:label "hasEvaluationResults" ;
    rdfs:domain nexus:everyevalairesult ;
    rdfs:range nexus:evaluationresultrecord ;
    skos:definition "Array of evaluation results" ;
    skos:inScheme nexus:ai_eval .

nexus:hasEvidenceCategory a owl:ObjectProperty ;
    rdfs:label "hasEvidenceCategory" ;
    rdfs:domain nexus:ControlActivity ;
    rdfs:range nexus:AIUC1EvidenceCategory ;
    skos:definition "The evidence category, ie Technical Implementation, Operational Practices, etc." ;
    skos:inScheme nexus:ai_aiuc .

nexus:hasInputModality a owl:ObjectProperty ;
    rdfs:label "hasInputModality" ;
    rdfs:range airo:Modality ;
    skos:definition "A relationship indicating the input modalities supported by an AI component. Examples include text, image, video." ;
    skos:inScheme nexus:ai_system .

nexus:hasInterpretation a owl:DatatypeProperty ;
    rdfs:label "hasInterpretation" ;
    skos:definition "How users should interpret the scores or results from the metrics." ;
    skos:inScheme nexus:ai_eval .

nexus:hasKeywords a owl:DatatypeProperty ;
    rdfs:label "hasKeywords" ;
    rdfs:domain nexus:Requirement ;
    rdfs:range xsd:string ;
    skos:definition "A collection of keywords" ;
    skos:inScheme nexus:ai_aiuc .

nexus:hasModelCard a owl:DatatypeProperty ;
    rdfs:label "hasModelCard" ;
    rdfs:range xsd:string ;
    skos:definition "A relationship to model card references." ;
    skos:inScheme nexus:ai_system .

nexus:hasOutOfScopeUses a owl:DatatypeProperty ;
    rdfs:label "hasOutOfScopeUses" ;
    skos:definition "Use cases where the benchmark is not designed to be applied and could give misleading results." ;
    skos:inScheme nexus:ai_eval .

nexus:hasOutputModality a owl:ObjectProperty ;
    rdfs:label "hasOutputModality" ;
    rdfs:range airo:Modality ;
    skos:definition "A relationship indicating the output modalities supported by an AI component. Examples include text, image, video." ;
    skos:inScheme nexus:ai_system .

nexus:hasParentDefinition a owl:ObjectProperty ;
    rdfs:label "hasParentDefinition" ;
    rdfs:range nexus:Term ;
    skos:definition "Indicates parent terms associated with a term" ;
    skos:inScheme nexus:common .

nexus:hasRelatedAction a owl:ObjectProperty ;
    rdfs:label "hasRelatedAction" ;
    rdfs:range nexus:Action ;
    skos:definition "A relationship where an entity relates to an action" ;
    skos:inScheme nexus:ai_risk .

nexus:hasRelatedTerm a owl:ObjectProperty ;
    rdfs:label "hasRelatedTerm" ;
    rdfs:domain linkml:Any ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( airo:RiskConcept nexus:Term ) ] nexus:Term ) ] ;
    skos:definition "A relationship where an entity relates to a term" ;
    skos:inScheme nexus:common .

nexus:hasSimilarBenchmarks a owl:DatatypeProperty ;
    rdfs:label "hasSimilarBenchmarks" ;
    skos:definition "Benchmarks that are closely related in terms of goals or data type." ;
    skos:inScheme nexus:ai_eval .

nexus:hasSubDefinition a owl:ObjectProperty ;
    rdfs:label "hasSubDefinition" ;
    rdfs:range nexus:Term ;
    skos:definition "Indicates child terms associated with a term" ;
    skos:inScheme nexus:common .

nexus:hasTypicalLocation a owl:DatatypeProperty ;
    rdfs:label "hasTypicalLocation" ;
    rdfs:domain nexus:ControlActivity ;
    rdfs:range xsd:string ;
    skos:definition "The evidence is usually found here" ;
    skos:inScheme nexus:ai_aiuc .

nexus:hasValidation a owl:DatatypeProperty ;
    rdfs:label "hasValidation" ;
    skos:definition "Measures taken to ensure that the benchmark provides valid and reliable evaluations." ;
    skos:inScheme nexus:ai_eval .

nexus:licenses a owl:ObjectProperty ;
    rdfs:label "licenses" ;
    skos:definition "A list of licenses" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:llmintrinsics a owl:ObjectProperty ;
    rdfs:label "llmintrinsics" ;
    skos:definition "A list of LLMIntrinsics" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:modalities a owl:ObjectProperty ;
    rdfs:label "modalities" ;
    skos:definition "A list of AI modalities" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:obligations a owl:ObjectProperty ;
    rdfs:label "obligations" ;
    skos:definition "A list of Obligations" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:organizations a owl:ObjectProperty ;
    rdfs:label "organizations" ;
    skos:definition "A list of organizations" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:performsTask a owl:ObjectProperty ;
    rdfs:label "performsTask" ;
    rdfs:range airo:AiCapability ;
    skos:definition "relationship indicating the AI tasks an AI model can perform." ;
    skos:inScheme nexus:ai_system .

nexus:permissions a owl:ObjectProperty ;
    rdfs:label "permissions" ;
    skos:definition "A list of Permissions" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:policies a owl:ObjectProperty ;
    rdfs:label "policies" ;
    skos:definition "A list of policies" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:prohibitions a owl:ObjectProperty ;
    rdfs:label "prohibitions" ;
    skos:definition "A list of prohibitions" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:refersToRisk a owl:ObjectProperty ;
    rdfs:label "refersToRisk" ;
    rdfs:domain dpv-risk:Incident ;
    rdfs:range airo:Risk ;
    skos:definition "Indicates the incident (subject) is a materialisation of the indicated risk (object)" ;
    skos:exactMatch dpv:refersToRisk ;
    skos:inScheme nexus:ai_risk .

nexus:riskincidents a owl:ObjectProperty ;
    rdfs:label "riskincidents" ;
    skos:definition "A list of AI risk incidents" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:rules a owl:ObjectProperty ;
    rdfs:label "rules" ;
    skos:definition "A list of rules" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:slot_conditions a owl:ObjectProperty ;
    rdfs:label "slot_conditions" ;
    skos:definition "List of slot conditions that must be satisfied." ;
    skos:inScheme nexus:common .

nexus:stakeholdergroups a owl:ObjectProperty ;
    rdfs:label "stakeholdergroups" ;
    skos:definition "A list of AI stakeholder groups" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:stakeholders a owl:ObjectProperty ;
    rdfs:label "stakeholders" ;
    skos:definition "A list of stakeholders" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:supported_languages a owl:DatatypeProperty ;
    rdfs:label "supported_languages" ;
    rdfs:range xsd:string ;
    skos:definition "A list of languages, expressed as ISO two letter codes. For example, 'jp, fr, en, de'" ;
    skos:inScheme nexus:ai_system .

nexus:taxonomies a owl:ObjectProperty ;
    rdfs:label "taxonomies" ;
    skos:definition "A list of taxonomies" ;
    skos:inScheme nexus:ai-risk-ontology .

nexus:vocabularies a owl:ObjectProperty ;
    rdfs:label "vocabularies" ;
    skos:definition "A list of vocabularies" ;
    skos:inScheme nexus:ai-risk-ontology .

airo:AIComponent a owl:Class ;
    rdfs:label "AIComponent" ;
    rdfs:subClassOf <http://schema.org/Thing> ;
    skos:definition "Component (element) of an AI system" ;
    skos:exactMatch nexus:AIComponent ;
    skos:inScheme nexus:ai_system .

airo:AIDeployer a owl:Class ;
    rdfs:label "AIDeployer" ;
    rdfs:subClassOf airo:AIOperator ;
    skos:definition "Any natural or legal person, public authority, agency or other body using an AI system under its authority except where the AI system is used in the course of a personal non-professional activity." ;
    skos:exactMatch nexus:AIDeployer ;
    skos:inScheme nexus:ai_system .

airo:AIDeveloper a owl:Class ;
    rdfs:label "AIDeveloper" ;
    rdfs:subClassOf airo:Stakeholder ;
    skos:definition "An organisation or entity that is concerned with the development of AI services and products." ;
    skos:exactMatch nexus:AIDeveloper ;
    skos:inScheme nexus:ai_system .

airo:AISubject a owl:Class ;
    rdfs:label "AISubject" ;
    rdfs:subClassOf airo:Stakeholder ;
    skos:definition "An entity that is subject to or impacted by the use of AI." ;
    skos:exactMatch nexus:AISubject ;
    skos:inScheme nexus:ai_system .

airo:AIUser a owl:Class ;
    rdfs:label "AIUser" ;
    rdfs:subClassOf airo:Stakeholder ;
    skos:definition "Individual or group that interacts with a system." ;
    skos:exactMatch nexus:AIUser ;
    skos:inScheme nexus:ai_system .

airo:hasAISubject a owl:ObjectProperty ;
    rdfs:label "hasAISubject" ;
    rdfs:range airo:AISubject ;
    skos:definition "Indicates the subjects of an AI system" ;
    skos:inScheme nexus:ai_system .

airo:hasAiUser a owl:ObjectProperty ;
    rdfs:label "hasAIUser" ;
    rdfs:domain airo:AISystem ;
    rdfs:range airo:AIUser ;
    skos:definition "Indicate the end-user of an AI system." ;
    skos:inScheme nexus:ai_system .

airo:hasPurpose a owl:ObjectProperty ;
    rdfs:label "hasPurpose" ;
    rdfs:range airo:Purpose ;
    skos:definition "Indicates the purpose of an entity, e.g. AI system, components." ;
    skos:inScheme nexus:ai_system .

airo:hasRiskControl a owl:ObjectProperty ;
    rdfs:label "hasRiskControl" ;
    rdfs:range airo:RiskControl ;
    skos:definition "Indicates the control measures associated with a system or component to modify risks." ;
    skos:inScheme nexus:ai_system .

airo:hasStakeholder a owl:ObjectProperty ;
    rdfs:label "hasStakeholder" ;
    rdfs:range airo:Stakeholder ;
    skos:definition "Indicates stakeholders of an AI system or component." ;
    skos:inScheme nexus:ai_system .

airo:hasTrainingData a owl:ObjectProperty ;
    rdfs:label "hasTrainingData" ;
    rdfs:range <http://schema.org/Dataset> ;
    skos:definition "A relationship indicating the datasets an AI model was trained on." ;
    skos:inScheme nexus:ai_system .

airo:isAppliedWithinDomain a owl:ObjectProperty ;
    rdfs:label "isAppliedWithinDomain" ;
    rdfs:range airo:Domain ;
    skos:definition "Specifies the domain an AI system is used within." ;
    skos:inScheme nexus:ai_system .

dpv:isPartOf a owl:ObjectProperty ;
    rdfs:label "hasPrinciple" ;
    rdfs:domain nexus:Requirement ;
    rdfs:range dpv:Principle ;
    skos:definition "Which of the AIUC-1 principles this requirement belongs to" ;
    skos:inScheme nexus:ai_aiuc .

dqv:hasQualityMeasurement a owl:ObjectProperty ;
    rdfs:label "hasEvaluation" ;
    rdfs:range dqv:QualityMeasurement ;
    skos:definition "A relationship indicating that an entity has an AI evaluation result." ;
    skos:inScheme nexus:ai_eval .

<http://schema.org/dateCreated> a owl:DatatypeProperty ;
    rdfs:label "dateCreated" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the entity was created." ;
    skos:inScheme nexus:common .

<http://schema.org/dateModified> a owl:DatatypeProperty ;
    rdfs:label "dateModified" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the entity was most recently modified." ;
    skos:inScheme nexus:common .

<http://schema.org/description> a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:definition "The description of an entity" ;
    skos:inScheme nexus:common .

<http://schema.org/identifier> a owl:DatatypeProperty ;
    rdfs:label "id" ;
    skos:definition "A unique identifier to this instance of the model element. Example identifiers include UUID, URI, URN, etc." ;
    skos:inScheme nexus:common .

<http://schema.org/name> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "A text name of this instance." ;
    skos:inScheme nexus:common .

adms:status a owl:ObjectProperty ;
    rdfs:label "hasLifecycleStatus" ;
    rdfs:range nexus:LifecycleStatus ;
    skos:altLabel "doc_status",
        "lifecycle_status" ;
    skos:definition "The editorial / publication lifecycle state of this entity. Distinct from AiLifecyclePhase, which describes an AI system's runtime evolution rather than the editorial workflow of a catalogued entry." ;
    skos:inScheme nexus:common .

nexus:AiTaskTaxonomy a owl:Class ;
    rdfs:label "AiTaskTaxonomy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:License ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:hasLicense ],
        skos:ConceptScheme ;
    skos:definition "A taxonomy of AI Tasks" ;
    skos:inScheme nexus:ai_system .

nexus:AttributeConditionRule a owl:Class ;
    rdfs:label "AttributeConditionRule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nexus:AnonymousClassExpression ;
            owl:onProperty nexus:preconditions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:postconditions ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:AnonymousClassExpression ;
            owl:onProperty nexus:postconditions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:preconditions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:postconditions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:preconditions ],
        dpv:Rule ;
    skos:inScheme nexus:common .

nexus:LLMQuestionPolicy a owl:Class ;
    rdfs:label "LLMQuestionPolicy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasException ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasException ],
        [ a owl:Restriction ;
            owl:allValuesFrom dpv:Rule ;
            owl:onProperty dpv:hasRule ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasReasonDenial ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasShortReplyType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasShortReplyType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasShortReplyType ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Any ;
            owl:onProperty nexus:hasRelatedRisk ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasReasonDenial ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasReasonDenial ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasException ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dpv:hasRule ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasRelatedRisk ],
        dpv:Policy ;
    skos:definition "The policy guides how the language model should answer a diverse set of sensitive questions." ;
    skos:inScheme nexus:common .

nexus:LargeLanguageModelFamily a owl:Class ;
    rdfs:label "LargeLanguageModelFamily" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        <http://schema.org/Thing> ;
    skos:definition "A large language model family is a set of models that are provided by the same AI systems provider and are built around the same architecture, but differ e.g. in the number of parameters. Examples are Meta's Llama2 family or the IBM granite models." ;
    skos:inScheme nexus:ai_system .

nexus:RiskControlGroup a owl:Class ;
    rdfs:label "RiskControlGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty skos:member ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:RiskControl ;
            owl:onProperty skos:member ],
        skos:Collection,
        airo:RiskConcept ;
    skos:definition "A group of AI system related risk controls." ;
    skos:inScheme nexus:ai_risk .

nexus:RiskControlGroupTaxonomy a owl:Class ;
    rdfs:label "RiskControlGroupTaxonomy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:License ;
            owl:onProperty airo:hasLicense ],
        skos:ConceptScheme ;
    skos:definition "A taxonomy of AI system related risk controls groups" ;
    skos:inScheme nexus:ai_risk .

nexus:RiskTaxonomy a owl:Class ;
    rdfs:label "RiskTaxonomy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom airo:License ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        skos:ConceptScheme ;
    skos:definition "A taxonomy of AI system related risks" ;
    skos:inScheme nexus:ai_risk .

nexus:SupraNationalJurisdiction a owl:Class ;
    rdfs:label "SupraNationalJurisdiction" ;
    skos:definition "Supra-national or intergovernmental jurisdiction, sourced from the DPV Location ontology (https://w3id.org/dpv/loc). Values are subclasses of dpv:SupraNationalUnion (e.g. EU, EEA)." ;
    skos:inScheme nexus:common ;
    linkml:permissible_values <https://w3id.org/ai-atlas-nexus/SupraNationalJurisdiction#International> .

nexus:architecture a owl:DatatypeProperty ;
    rdfs:label "architecture" ;
    rdfs:range xsd:string ;
    skos:definition "A description of the architecture of an AI such as 'Decoder-only'." ;
    skos:inScheme nexus:ai_system .

nexus:bestValue a owl:DatatypeProperty ;
    rdfs:label "bestValue" ;
    skos:definition "Annotation of the best possible result of the evaluation" ;
    skos:inScheme nexus:ai_eval .

nexus:carbon_emitted a owl:DatatypeProperty ;
    rdfs:label "carbon_emitted" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "The number of tons of carbon dioxide equivalent that are emitted during training" ;
    skos:inScheme nexus:energy .

nexus:concern a owl:DatatypeProperty ;
    rdfs:label "concern" ;
    skos:definition "Some explanation about the concern related to an AI risk" ;
    skos:inScheme nexus:ai_risk .

nexus:contextWindowSize a owl:DatatypeProperty ;
    rdfs:label "contextWindowSize" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "The total length, in bytes, of an AI model's context window." ;
    skos:inScheme nexus:ai_system .

nexus:dataset_name a owl:DatatypeProperty ;
    rdfs:label "dataset_name" ;
    skos:definition "Name of the dataset" ;
    skos:inScheme nexus:ai_eval .

nexus:describesAiEval a owl:ObjectProperty ;
    rdfs:label "describesAiEval" ;
    rdfs:domain nexus:benchmarkmetadatacard ;
    rdfs:range dqv:Metric ;
    owl:inverseOf nexus:hasBenchmarkMetadata ;
    skos:definition "A relationship where a BenchmarkMetadataCard describes an AI evaluation (benchmark)." ;
    skos:inScheme nexus:ai_eval .

nexus:equals_string a owl:DatatypeProperty ;
    rdfs:label "equals_string" ;
    skos:definition "The string value that the slot must equal to satisfy this condition." ;
    skos:inScheme nexus:common .

nexus:evaluation_id a owl:DatatypeProperty ;
    rdfs:label "evaluation_id" ;
    skos:definition "Unique identifier for this evaluation" ;
    skos:inScheme nexus:ai_eval .

nexus:evaluation_name a owl:DatatypeProperty ;
    rdfs:label "evaluation_name" ;
    skos:definition "Name of the evaluation benchmark" ;
    skos:inScheme nexus:ai_eval .

nexus:evaluation_timestamp a owl:DatatypeProperty ;
    rdfs:label "evaluation_timestamp" ;
    skos:definition "ISO 8601 timestamp when evaluation was performed" ;
    skos:inScheme nexus:ai_eval .

nexus:evaluator_relationship a owl:DatatypeProperty ;
    rdfs:label "evaluator_relationship" ;
    skos:definition "Relationship of evaluator (e.g., first_party, third_party)" ;
    skos:inScheme nexus:ai_eval .

nexus:everyevalairesult a owl:Class ;
    rdfs:label "EveryEvalAIResult" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasDataType ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:RiskConcept ;
            owl:onProperty nexus:hasRelatedRisk ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:retrieved_timestamp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:evaluation_timestamp ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasGoal ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasModelInfo ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasLimitations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasDataSize ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasDataFormat ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasModelInfo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasResources ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasMethods ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasDomains ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasGoal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:evaluation_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasDataType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:schema_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:schema_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasResources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasLimitations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasDataSource ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:evaluation_timestamp ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasRelatedRisk ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasGoal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasSourceMetadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasMethods ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:evaluationresultrecord ;
            owl:onProperty nexus:hasEvaluationResults ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasMetrics ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasDataSize ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty nexus:evaluation_timestamp ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:modelinfo ;
            owl:onProperty nexus:hasModelInfo ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasMetrics ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:sourcemetadata ;
            owl:onProperty nexus:hasSourceMetadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasTasks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasSourceMetadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:evaluation_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasEvaluationResults ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasDataSize ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasTasks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasAudience ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasAudience ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:schema_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:retrieved_timestamp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:evaluation_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasDomains ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasLanguages ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasLanguages ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasDataSource ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:retrieved_timestamp ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasDataFormat ],
        dqv:QualityMeasurement ;
    skos:definition "An evaluation result from the Every Eval Ever dataset, capturing evaluation metadata and results from the EEE_datastore." ;
    skos:exactMatch nexus:EveryEvalAIResult ;
    skos:inScheme nexus:ai_eval .

nexus:evidence a owl:DatatypeProperty ;
    rdfs:label "evidence" ;
    skos:definition "Evidence provides a source (typical a chunk, paragraph or link) describing where some value was found or how it was generated." ;
    skos:inScheme nexus:common .

nexus:fine_tuning a owl:DatatypeProperty ;
    rdfs:label "fine_tuning" ;
    rdfs:range xsd:string ;
    skos:definition "A description of the fine-tuning mechanism(s) applied to a model." ;
    skos:inScheme nexus:ai_system .

nexus:gpu_hours a owl:DatatypeProperty ;
    rdfs:label "gpu_hours" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "GPU consumption in terms of hours" ;
    skos:inScheme nexus:energy .

nexus:grants_license a owl:ObjectProperty ;
    rdfs:label "grants_license" ;
    rdfs:range airo:License ;
    skos:definition "A relationship from a granting entity such as an Organization to a License instance." ;
    skos:inScheme nexus:common .

nexus:hasBenchmarkMetadata a owl:ObjectProperty ;
    rdfs:label "hasBenchmarkMetadata" ;
    rdfs:domain dqv:Metric ;
    rdfs:range nexus:benchmarkmetadatacard ;
    owl:inverseOf nexus:describesAiEval ;
    skos:definition "A relationship to a Benchmark Metadata Card which contains metadata about the benchmark." ;
    skos:inScheme nexus:ai_eval .

nexus:hasConsequence a owl:ObjectProperty ;
    rdfs:label "hasConsequence" ;
    rdfs:domain airo:RiskConcept ;
    rdfs:range dpv:Consequence ;
    skos:definition "Indicates consequence(s) possible or arising from specified concept" ;
    skos:inScheme nexus:ai_risk .

nexus:hasControlApplication a owl:ObjectProperty ;
    rdfs:label "hasControlApplication" ;
    rdfs:domain nexus:ControlActivity ;
    rdfs:range nexus:AIUC1ControlApplicationCategory ;
    skos:definition "Which of the AIUC-1 ControlApplicationCategory this control activity (rule) belongs to" ;
    skos:inScheme nexus:ai_aiuc .

nexus:hasEuAiSystemType a owl:ObjectProperty ;
    rdfs:label "hasEuAiSystemType" ;
    rdfs:range nexus:AiSystemType ;
    skos:definition "The type of system as defined by the EU AI Act." ;
    skos:inScheme nexus:eu_ai_act .

nexus:hasEuRiskCategory a owl:ObjectProperty ;
    rdfs:label "hasEuRiskCategory" ;
    rdfs:range nexus:EuAiRiskCategory ;
    skos:definition "The risk category of an AI system as defined by the EU AI Act." ;
    skos:inScheme nexus:eu_ai_act .

nexus:hasException a owl:DatatypeProperty ;
    rdfs:label "hasException" ;
    rdfs:range xsd:string ;
    skos:definition "Exception type" ;
    skos:inScheme nexus:common .

nexus:hasFrequency a owl:ObjectProperty ;
    rdfs:label "hasFrequency" ;
    rdfs:domain nexus:Requirement ;
    rdfs:range nexus:AIUC1Frequency ;
    skos:definition "The frequency" ;
    skos:inScheme nexus:ai_aiuc .

nexus:hasImpact a owl:ObjectProperty ;
    rdfs:label "hasImpact" ;
    rdfs:domain airo:RiskConcept ;
    rdfs:range dpv:Impact ;
    skos:broadMatch dpv:hasConsequence ;
    skos:definition "Indicates impact(s) possible or arising as consequences from specified concept" ;
    skos:inScheme nexus:ai_risk .

nexus:hasImpactOn a owl:ObjectProperty ;
    rdfs:label "hasImpactOn" ;
    rdfs:domain airo:RiskConcept ;
    rdfs:range dpv:Impact ;
    skos:broadMatch dpv:hasConsequenceOn ;
    skos:definition "Indicates impact(s) possible or arising as consequences from specified concept" ;
    skos:inScheme nexus:ai_risk .

nexus:hasLikelihood a owl:ObjectProperty ;
    rdfs:label "hasLikelihood" ;
    rdfs:domain airo:RiskConcept ;
    rdfs:range dpv:Likelihood ;
    skos:definition "The likelihood or probability or chance of something taking place or occuring" ;
    skos:inScheme nexus:ai_risk .

nexus:hasMetricConfig a owl:ObjectProperty ;
    rdfs:label "hasMetricConfig" ;
    rdfs:domain nexus:evaluationresultrecord ;
    rdfs:range nexus:metricconfig ;
    skos:definition "Metric configuration" ;
    skos:inScheme nexus:ai_eval .

nexus:hasModelInfo a owl:ObjectProperty ;
    rdfs:label "hasModelInfo" ;
    rdfs:domain nexus:everyevalairesult ;
    rdfs:range nexus:modelinfo ;
    skos:definition "Model information for the evaluation" ;
    skos:inScheme nexus:ai_eval .

nexus:hasReasonDenial a owl:DatatypeProperty ;
    rdfs:label "hasReasonDenial" ;
    rdfs:range xsd:string ;
    skos:definition "Reason for denial" ;
    skos:inScheme nexus:common .

nexus:hasRequirement a owl:ObjectProperty ;
    rdfs:label "hasRequirement" ;
    rdfs:domain nexus:ControlActivity ;
    rdfs:range nexus:Requirement ;
    skos:definition "This requirement this rule belongs to" ;
    skos:inScheme nexus:ai_aiuc .

nexus:hasScoreDetails a owl:ObjectProperty ;
    rdfs:label "hasScoreDetails" ;
    rdfs:domain nexus:evaluationresultrecord ;
    rdfs:range nexus:scoredetails ;
    skos:definition "Score details" ;
    skos:inScheme nexus:ai_eval .

nexus:hasSeverity a owl:ObjectProperty ;
    rdfs:label "hasSeverity" ;
    rdfs:domain airo:RiskConcept ;
    rdfs:range dpv:Severity ;
    skos:definition "Indicates the severity associated with a concept" ;
    skos:inScheme nexus:ai_risk .

nexus:hasShortReplyType a owl:DatatypeProperty ;
    rdfs:label "hasShortReplyType" ;
    rdfs:range xsd:string ;
    skos:definition "Short reply type" ;
    skos:inScheme nexus:common .

nexus:hasSourceData a owl:ObjectProperty ;
    rdfs:label "hasSourceData" ;
    rdfs:domain nexus:evaluationresultrecord ;
    rdfs:range nexus:sourcedata ;
    skos:definition "Source data information" ;
    skos:inScheme nexus:ai_eval .

nexus:hasSourceMetadata a owl:ObjectProperty ;
    rdfs:label "hasSourceMetadata" ;
    rdfs:domain nexus:everyevalairesult ;
    rdfs:range nexus:sourcemetadata ;
    skos:definition "Source metadata for the evaluation" ;
    skos:inScheme nexus:ai_eval .

nexus:hasStatus a owl:ObjectProperty ;
    rdfs:label "hasStatus" ;
    rdfs:domain airo:RiskConcept ;
    rdfs:range dpv:IncidentStatus ;
    skos:definition "Indicates the status of specified concept" ;
    skos:inScheme nexus:ai_risk .

nexus:hasTypicalEvidence a owl:DatatypeProperty ;
    rdfs:label "hasTypicalEvidence" ;
    rdfs:domain nexus:ControlActivity ;
    rdfs:range xsd:string ;
    skos:definition "The evidence is usually found here" ;
    skos:inScheme nexus:ai_aiuc .

nexus:hasVariant a owl:ObjectProperty ;
    rdfs:label "hasVariant" ;
    rdfs:domain dpv-risk:Incident ;
    rdfs:range dpv-risk:Incident ;
    skos:definition "Indicates an incident that shares the same causative factors, produces similar harms, and involves the same intelligent systems as a known AI incident." ;
    skos:inScheme nexus:ai_risk .

nexus:hf_repo a owl:DatatypeProperty ;
    rdfs:label "hf_repo" ;
    skos:definition "HuggingFace repository" ;
    skos:inScheme nexus:ai_eval .

nexus:hf_split a owl:DatatypeProperty ;
    rdfs:label "hf_split" ;
    skos:definition "HuggingFace dataset split" ;
    skos:inScheme nexus:ai_eval .

nexus:isDetectedBy a owl:ObjectProperty ;
    rdfs:label "isDetectedBy" ;
    rdfs:domain airo:RiskConcept ;
    rdfs:range airo:RiskControl ;
    owl:inverseOf nexus:detectsRiskConcept ;
    skos:definition "A relationship where a risk, risk source, consequence, or impact is detected by a risk control." ;
    skos:inScheme nexus:ai_risk .

nexus:isMitigatedBy a owl:ObjectProperty ;
    rdfs:label "isMitigatedBy" ;
    rdfs:domain airo:RiskConcept ;
    rdfs:range airo:RiskControl ;
    owl:inverseOf nexus:mitigatesRiskConcept ;
    skos:definition "A relationship where a risk, risk source, consequence, or impact is mitigated by a risk control." ;
    skos:inScheme nexus:ai_risk .

nexus:isProducedBy a owl:ObjectProperty ;
    rdfs:label "isProducedBy" ;
    rdfs:range <http://schema.org/Organization> ;
    skos:definition "A relationship to the Organization instance which produces this instance." ;
    skos:inScheme nexus:common .

nexus:lower_is_better a owl:DatatypeProperty ;
    rdfs:label "lower_is_better" ;
    skos:definition "Whether lower scores are better" ;
    skos:inScheme nexus:ai_eval .

nexus:max_score a owl:DatatypeProperty ;
    rdfs:label "max_score" ;
    skos:definition "Maximum possible score" ;
    skos:inScheme nexus:ai_eval .

nexus:metricconfig a owl:Class ;
    rdfs:label "MetricConfig" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty nexus:lower_is_better ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:lower_is_better ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:score_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty nexus:min_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty nexus:max_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:max_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:min_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:min_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:lower_is_better ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:score_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:max_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:score_type ],
        <http://schema.org/Thing> ;
    skos:definition "Configuration for evaluation metrics" ;
    skos:exactMatch nexus:MetricConfig ;
    skos:inScheme nexus:ai_eval .

nexus:min_score a owl:DatatypeProperty ;
    rdfs:label "min_score" ;
    skos:definition "Minimum possible score" ;
    skos:inScheme nexus:ai_eval .

nexus:mitigatesRiskConcept a owl:ObjectProperty ;
    rdfs:label "mitigatesRiskConcept" ;
    rdfs:domain airo:RiskControl ;
    rdfs:range airo:RiskConcept ;
    owl:inverseOf nexus:isMitigatedBy ;
    skos:definition "Indicates the control used for mitigating risks, risk sources, consequences, and impacts." ;
    skos:exactMatch airo:mitigatesRiskConcept ;
    skos:inScheme nexus:ai_risk .

nexus:model_id a owl:DatatypeProperty ;
    rdfs:label "model_id" ;
    skos:definition "Identifier of the AI model" ;
    skos:inScheme nexus:ai_eval .

nexus:model_name a owl:DatatypeProperty ;
    rdfs:label "model_name" ;
    skos:definition "Name of the AI model" ;
    skos:inScheme nexus:ai_eval .

nexus:modelinfo a owl:Class ;
    rdfs:label "ModelInfo" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:model_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:model_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:model_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:model_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:model_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:model_name ],
        <http://schema.org/Thing> ;
    skos:definition "Information about the AI model being evaluated" ;
    skos:exactMatch nexus:ModelInfo ;
    skos:inScheme nexus:ai_eval .

nexus:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "The official name of the benchmark." ;
    skos:inScheme nexus:ai_eval .

nexus:numParameters a owl:DatatypeProperty ;
    rdfs:label "numParameters" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "A property indicating the number of parameters in a LLM." ;
    skos:inScheme nexus:ai_system .

nexus:numTrainingTokens a owl:DatatypeProperty ;
    rdfs:label "numTrainingTokens" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "The number of tokens a AI model was trained on." ;
    skos:inScheme nexus:ai_system .

nexus:overview a owl:DatatypeProperty ;
    rdfs:label "overview" ;
    skos:definition "A brief description of the benchmark's main goals and scope." ;
    skos:inScheme nexus:ai_eval .

nexus:phase a owl:DatatypeProperty ;
    rdfs:label "phase" ;
    skos:definition "Annotation whether an AI risk shows specifically during the training-tuning or inference phase." ;
    skos:inScheme nexus:ai_risk .

nexus:postconditions a owl:ObjectProperty ;
    rdfs:label "postconditions" ;
    skos:definition "Conditions that result from applying the rule." ;
    skos:inScheme nexus:common .

nexus:power_consumption_w a owl:DatatypeProperty ;
    rdfs:label "power_consumption_w" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "power consumption in Watts" ;
    skos:inScheme nexus:energy .

nexus:preconditions a owl:ObjectProperty ;
    rdfs:label "preconditions" ;
    skos:definition "Conditions that must be satisfied before the rule applies." ;
    skos:inScheme nexus:common .

nexus:retrieved_timestamp a owl:DatatypeProperty ;
    rdfs:label "retrieved_timestamp" ;
    skos:definition "Unix timestamp when the data was retrieved" ;
    skos:inScheme nexus:ai_eval .

nexus:risk_type a owl:DatatypeProperty ;
    rdfs:label "risk_type" ;
    skos:definition "Annotation whether an AI risk occurs at input or output or is non-technical." ;
    skos:inScheme nexus:ai_risk .

nexus:schema_version a owl:DatatypeProperty ;
    rdfs:label "schema_version" ;
    skos:definition "Version of the evaluation schema" ;
    skos:inScheme nexus:ai_eval .

nexus:score a owl:DatatypeProperty ;
    rdfs:label "score" ;
    skos:definition "The evaluation score" ;
    skos:inScheme nexus:ai_eval .

nexus:score_type a owl:DatatypeProperty ;
    rdfs:label "score_type" ;
    skos:definition "Type of score (e.g., continuous)" ;
    skos:inScheme nexus:ai_eval .

nexus:scoredetails a owl:Class ;
    rdfs:label "ScoreDetails" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty nexus:score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:score ],
        <http://schema.org/Thing> ;
    skos:definition "Details about evaluation scores" ;
    skos:exactMatch nexus:ScoreDetails ;
    skos:inScheme nexus:ai_eval .

nexus:slot_name a owl:DatatypeProperty ;
    rdfs:label "slot_name" ;
    skos:definition "The name of the slot being evaluated in this condition." ;
    skos:inScheme nexus:common .

nexus:source_name a owl:DatatypeProperty ;
    rdfs:label "source_name" ;
    skos:definition "Name of the evaluation source" ;
    skos:inScheme nexus:ai_eval .

nexus:source_organization_name a owl:DatatypeProperty ;
    rdfs:label "source_organization_name" ;
    skos:definition "Organization that provided the evaluation" ;
    skos:inScheme nexus:ai_eval .

nexus:source_organization_url a owl:DatatypeProperty ;
    rdfs:label "source_organization_url" ;
    skos:definition "URL of the source organization" ;
    skos:inScheme nexus:ai_eval .

nexus:source_uri a owl:DatatypeProperty ;
    rdfs:label "source_uri" ;
    skos:definition "The uri of the incident" ;
    skos:inScheme nexus:ai_risk .

nexus:sourcedata a owl:Class ;
    rdfs:label "SourceData" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:source_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:source_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hf_repo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:dataset_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:dataset_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hf_repo ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:dataset_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hf_split ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hf_repo ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hf_split ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hf_split ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:source_type ],
        <http://schema.org/Thing> ;
    skos:definition "Information about the data source used in evaluation" ;
    skos:exactMatch nexus:SourceData ;
    skos:inScheme nexus:ai_eval .

nexus:sourcemetadata a owl:Class ;
    rdfs:label "SourceMetadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:source_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:evaluator_relationship ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:source_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:source_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:source_organization_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:source_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:source_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:source_organization_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:source_organization_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:source_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:evaluator_relationship ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:source_organization_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:evaluator_relationship ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty nexus:source_organization_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:source_organization_name ],
        <http://schema.org/Thing> ;
    skos:definition "Metadata about the source of an evaluation" ;
    skos:exactMatch nexus:SourceMetadata ;
    skos:inScheme nexus:ai_eval .

nexus:tag a owl:DatatypeProperty ;
    rdfs:label "tag" ;
    skos:definition "A shost version of the name" ;
    skos:inScheme nexus:ai_risk .

nexus:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    skos:definition "The question itself" ;
    skos:inScheme nexus:ai_eval .

nexus:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "Some numeric or string value" ;
    skos:inScheme nexus:common .

airo:AILifecyclePhase a owl:Class ;
    rdfs:label "AiLifecyclePhase" ;
    rdfs:subClassOf [ owl:unionOf ( nexus:AiModelValidation nexus:DataPreprocessing ) ],
        <http://schema.org/Thing> ;
    skos:definition "A Phase of AI lifecycle which indicates evolution of the system from conception through retirement." ;
    skos:exactMatch nexus:AiLifecyclePhase ;
    skos:inScheme nexus:ai_system .

airo:isDeployedBy a owl:ObjectProperty ;
    rdfs:label "isDeployedBy" ;
    rdfs:range airo:AIDeployer ;
    skos:definition "Indicates the deployer of an AI system or component." ;
    skos:inScheme nexus:ai_system .

airo:isDevelopedBy a owl:ObjectProperty ;
    rdfs:label "isDevelopedBy" ;
    rdfs:range airo:AIDeveloper ;
    skos:definition "Indicates the developer of an AI system or component." ;
    skos:inScheme nexus:ai_system .

dpv:Certification a owl:Class ;
    rdfs:label "Certification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        nexus:Entry ;
    skos:definition "Certification mechanisms, seals, and marks for the purpose of demonstrating compliance" ;
    skos:exactMatch nexus:Certification ;
    skos:inScheme nexus:common .

dpv:Consequence a owl:Class ;
    rdfs:label "Consequence" ;
    rdfs:subClassOf <http://schema.org/Thing> ;
    skos:exactMatch nexus:Consequence ;
    skos:inScheme nexus:ai_risk .

dpv:Likelihood a owl:Class ;
    rdfs:label "Likelihood" ;
    rdfs:subClassOf <http://schema.org/Thing> ;
    skos:exactMatch nexus:Likelihood ;
    skos:inScheme nexus:ai_risk .

dpv:Severity a owl:Class ;
    rdfs:label "Severity" ;
    rdfs:subClassOf <http://schema.org/Thing> ;
    skos:exactMatch nexus:Severity ;
    skos:inScheme nexus:ai_risk .

dpv:hasJurisdiction a owl:DatatypeProperty ;
    rdfs:label "hasJurisdiction" ;
    rdfs:range [ owl:unionOf ( nexus:Jurisdiction nexus:SupraNationalJurisdiction nexus:SubnationalJurisdiction ) ] ;
    rdfs:seeAlso dpv:hasJurisdiction ;
    skos:definition "The legal or regulatory jurisdiction(s) applicable to an AI system, policy, risk, or obligation. Accepts ISO 3166-1 country codes, supra-national bodies, or subnational jurisdictions with distinct regulatory significance. Aligns with dpv:hasJurisdiction." ;
    skos:inScheme nexus:common .

dqv:isMeasurementOf a owl:ObjectProperty ;
    rdfs:label "isResultOf" ;
    rdfs:range dqv:Metric ;
    skos:definition "A relationship indicating that an entity is the result of an AI evaluation." ;
    skos:inScheme nexus:ai_eval .

skos:narrower a owl:DatatypeProperty .

nexus:AIUC1ApplicationCategory a owl:Class ;
    rdfs:label "AIUC1ApplicationCategory" ;
    skos:definition "AIUC1 Application Category" ;
    skos:inScheme nexus:ai_aiuc ;
    linkml:permissible_values <https://w3id.org/ai-atlas-nexus/AIUC1ApplicationCategory#MANDATORY>,
        <https://w3id.org/ai-atlas-nexus/AIUC1ApplicationCategory#OPTIONAL> .

nexus:AIUC1ControlApplicationCategory a owl:Class ;
    rdfs:label "AIUC1ControlApplicationCategory" ;
    skos:definition "AIUC1 ControlApplication Category" ;
    skos:inScheme nexus:ai_aiuc ;
    linkml:permissible_values <https://w3id.org/ai-atlas-nexus/AIUC1ControlApplicationCategory#CORE>,
        <https://w3id.org/ai-atlas-nexus/AIUC1ControlApplicationCategory#SUPPLEMENTAL> .

nexus:ControlActivityObligation a owl:Class ;
    rdfs:label "ControlActivityObligation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        nexus:ControlActivity,
        dpv:Obligation ;
    skos:definition "A control activity (rule) describing an obligation for performing an activity" ;
    skos:exactMatch nexus:ControlActivityObligation ;
    skos:inScheme nexus:ai_aiuc .

nexus:ControlActivityPermission a owl:Class ;
    rdfs:label "ControlActivityPermission" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        nexus:ControlActivity,
        dpv:Permission ;
    skos:definition "A control activity (rule) describing a permission to perform an activity" ;
    skos:exactMatch nexus:ControlActivityPermission ;
    skos:inScheme nexus:ai_aiuc .

nexus:ControlActivityProhibition a owl:Class ;
    rdfs:label "ControlActivityProhibition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        nexus:ControlActivity,
        dpv:Prohibition ;
    skos:definition "A control activity (rule) describing a prohibition to perform an activity" ;
    skos:exactMatch nexus:ControlActivityProhibition ;
    skos:inScheme nexus:ai_aiuc .

nexus:ControlActivityRecommendation a owl:Class ;
    rdfs:label "ControlActivityRecommendation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        nexus:ControlActivity,
        dpv:Recommendation ;
    skos:definition "A control activity (rule) describing a recommendation for performing an activity" ;
    skos:exactMatch nexus:ControlActivityRecommendation ;
    skos:inScheme nexus:ai_aiuc .

nexus:LargeLanguageModel a owl:Class ;
    rdfs:label "LargeLanguageModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom airo:Modality ;
            owl:onProperty nexus:hasOutputModality ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Modality ;
            owl:onProperty nexus:hasInputModality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasInputModality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:contextWindowSize ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty nexus:numTrainingTokens ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:numParameters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:fine_tuning ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:fine_tuning ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:LargeLanguageModelFamily ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:numTrainingTokens ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty nexus:numParameters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:numParameters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasOutputModality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:fine_tuning ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:supported_languages ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasTrainingData ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://schema.org/Dataset> ;
            owl:onProperty airo:hasTrainingData ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:numTrainingTokens ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Any ;
            owl:onProperty nexus:requiresCapability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:contextWindowSize ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:requiresCapability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:supported_languages ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty nexus:contextWindowSize ],
        nexus:AiModel ;
    skos:altLabel "LLM" ;
    skos:definition "A large language model (LLM) is an AI model which supports a range of language-related tasks such as generation, summarization, classification, among others. A LLM is implemented as an artificial neural networks using a transformer architecture." ;
    skos:inScheme nexus:ai_system .

nexus:RiskGroup a owl:Class ;
    rdfs:label "RiskGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom airo:Risk ;
            owl:onProperty skos:member ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty skos:member ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        skos:Collection,
        airo:RiskConcept ;
    skos:definition "A group of AI system related risks that are part of a risk taxonomy." ;
    skos:inScheme nexus:ai_risk .

nexus:hasAudience a owl:DatatypeProperty ;
    rdfs:label "hasAudience" ;
    skos:definition "The intended audience, such as researchers, developers, policymakers, etc." ;
    skos:inScheme nexus:ai_eval .

nexus:hasDataFormat a owl:DatatypeProperty ;
    rdfs:label "hasDataFormat" ;
    skos:definition "The structure and modality of the data (e.g., sentence pairs, question-answer format, tabular data)." ;
    skos:inScheme nexus:ai_eval .

nexus:hasDataSource a owl:DatatypeProperty ;
    rdfs:label "hasDataSource" ;
    skos:definition "The origin or source of the data used in the benchmark (e.g., curated datasets, user submissions)." ;
    skos:inScheme nexus:ai_eval .

nexus:hasDataType a owl:DatatypeProperty ;
    rdfs:label "hasDataType" ;
    skos:definition "The type of data used in the benchmark (e.g., text, images, or multi-modal)" ;
    skos:inScheme nexus:ai_eval .

nexus:hasDomains a owl:DatatypeProperty ;
    rdfs:label "hasDomains" ;
    skos:definition "The specific domains or areas where the benchmark is applied (e.g., natural language processing, computer vision)." ;
    skos:inScheme nexus:ai_eval .

nexus:hasExternalReference a owl:ObjectProperty ;
    rdfs:label "hasExternalReference" ;
    rdfs:range airo:Documentation ;
    skos:altLabel "additional resources",
        "external_links" ;
    skos:closeMatch rdfs:seeAlso ;
    skos:definition "External references / additional resources related to this entity, such as articles, tools, or datasets. Distinct from hasDocumentation, which documents the entity itself. External references are not necessarily curated or vetted, and quality will vary." ;
    skos:inScheme nexus:common .

nexus:hasLanguages a owl:DatatypeProperty ;
    rdfs:label "hasLanguages" ;
    skos:definition "The languages included in the dataset used by the benchmark (e.g., English, multilingual)." ;
    skos:inScheme nexus:ai_eval .

nexus:hasLimitations a owl:DatatypeProperty ;
    rdfs:label "hasLimitations" ;
    skos:definition "Limitations in evaluating or addressing risks, such as gaps in demographic coverage or specific domains." ;
    skos:inScheme nexus:ai_eval .

nexus:hasMethods a owl:DatatypeProperty ;
    rdfs:label "hasMethods" ;
    skos:definition "The evaluation techniques applied within the benchmark." ;
    skos:inScheme nexus:ai_eval .

nexus:hasMetrics a owl:DatatypeProperty ;
    rdfs:label "hasMetrics" ;
    skos:definition "The specific performance metrics used to assess models (e.g., accuracy, F1 score, precision, recall)." ;
    skos:inScheme nexus:ai_eval .

nexus:hasResources a owl:DatatypeProperty ;
    rdfs:label "hasResources" ;
    skos:definition "Links to relevant resources, such as repositories or papers related to the benchmark." ;
    skos:inScheme nexus:ai_eval .

nexus:implementedByAdapter a owl:ObjectProperty ;
    rdfs:label "implementedByAdapter" ;
    rdfs:domain linkml:Any ;
    rdfs:range linkml:Any ;
    owl:inverseOf nexus:implementsCapability ;
    skos:definition "Indicates that this capability is implemented by a specific adapter. This relationship distinguishes the abstract capability (what can be done) from the technical implementation mechanism (how it is added/extended via adapters)." ;
    skos:inScheme nexus:common .

nexus:isApplicableToCapability a owl:ObjectProperty ;
    rdfs:label "isApplicableToCapability" ;
    rdfs:domain nexus:ControlActivity ;
    rdfs:range airo:AiCapability ;
    skos:definition "This evidence only applies to AI systems with this capability" ;
    skos:inScheme nexus:ai_aiuc .

nexus:isApplicableinLocality a owl:ObjectProperty ;
    rdfs:label "isApplicableinLocality" ;
    rdfs:range airo:LocalityOfUse ;
    skos:definition "A relationship where an entity has is applicable in these localities." ;
    skos:inScheme nexus:common .

nexus:isCategorizedAs a owl:ObjectProperty ;
    rdfs:label "isCategorizedAs" ;
    rdfs:range linkml:Any ;
    skos:definition "A relationship where an entity has been deemed to be categorized" ;
    skos:inScheme nexus:common .

airo:AIProvider a owl:Class ;
    rdfs:label "AiProvider" ;
    rdfs:subClassOf <http://schema.org/Organization> ;
    skos:definition "A provider under the AI Act is defined by Article 3(3) as a natural or legal person or body that develops an AI system or general-purpose AI model or has an AI system or general-purpose AI model developed; and places that ystem or model on the market, or puts that system into service, under the provider's own name or trademark, whether for payment or free for charge." ;
    skos:exactMatch nexus:AiProvider ;
    skos:inScheme nexus:ai_system .

airo:isUsedWithinLocality a owl:ObjectProperty ;
    rdfs:label "isUsedWithinLocality" ;
    rdfs:range airo:LocalityOfUse ;
    skos:definition "Specifies the domain an AI system is used within." ;
    skos:inScheme nexus:common .

dpv:Recommendation a owl:Class ;
    rdfs:label "Recommendation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        nexus:ControlActivityRecommendation,
        dpv:Rule ;
    skos:definition "A rule describing a recommendation for performing an activity" ;
    skos:exactMatch nexus:Recommendation ;
    skos:inScheme nexus:common .

nexus:AIUC1Frequency a owl:Class ;
    rdfs:label "AIUC1Frequency" ;
    skos:definition "AIUC1 Frequency" ;
    skos:inScheme nexus:ai_aiuc ;
    linkml:permissible_values <https://w3id.org/ai-atlas-nexus/AIUC1Frequency#MONTHS_12>,
        <https://w3id.org/ai-atlas-nexus/AIUC1Frequency#MONTHS_3>,
        <https://w3id.org/ai-atlas-nexus/AIUC1Frequency#MONTHS_6> .

nexus:AIUC1RequirementType a owl:Class ;
    rdfs:label "AIUC1RequirementType" ;
    skos:definition "AIUC1 Requirement Type" ;
    skos:inScheme nexus:ai_aiuc ;
    linkml:permissible_values <https://w3id.org/ai-atlas-nexus/AIUC1RequirementType#DETECTIVE>,
        <https://w3id.org/ai-atlas-nexus/AIUC1RequirementType#PREVENTATIVE> .

nexus:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasAiActorTask ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Risk ;
            owl:onProperty nexus:hasRelatedRisk ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasAiActorTask ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasRelatedRisk ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        airo:RiskControl ;
    skos:definition "Action to remediate a risk" ;
    skos:inScheme nexus:ai_risk .

nexus:AdapterType a owl:Class ;
    rdfs:label "AdapterType" ;
    skos:inScheme nexus:ai_intrinsic ;
    linkml:permissible_values <https://w3id.org/ai-atlas-nexus/AdapterType#ALORA>,
        <https://w3id.org/ai-atlas-nexus/AdapterType#LORA>,
        <https://w3id.org/ai-atlas-nexus/AdapterType#X-LORA> .

nexus:AiTaskDomain a owl:Class ;
    rdfs:label "AiTaskDomain" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty skos:member ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:AiTaskGroup ;
            owl:onProperty skos:member ],
        skos:Collection ;
    skos:definition "A grouping of AI Tasks by domain." ;
    skos:exactMatch nexus:AiTaskDomain ;
    skos:inScheme nexus:ai_system .

nexus:AiTaskGroup a owl:Class ;
    rdfs:label "AiTaskGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty skos:member ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:AiTaskDomain ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AiCapability ;
            owl:onProperty skos:member ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        skos:Collection ;
    skos:definition "A group of AI Tasks." ;
    skos:exactMatch nexus:AiTaskGroup ;
    skos:inScheme nexus:ai_system .

nexus:BaseAi a owl:Class ;
    rdfs:label "BaseAi" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasModelCard ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AIProvider ;
            owl:onProperty airo:isProvidedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AiCapability ;
            owl:onProperty nexus:performsTask ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:hasModelCard ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:isProvidedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:performsTask ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:License ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://schema.org/Organization> ;
            owl:onProperty nexus:isProducedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:isProducedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:isProvidedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:isProducedBy ],
        <http://schema.org/Thing>,
        nexus:AiModel ;
    skos:definition "Any type of AI, be it a LLM, RL agent, SVM, etc." ;
    skos:inScheme nexus:ai_system .

nexus:CapabilityGroup a owl:Class ;
    rdfs:label "CapabilityGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nexus:CapabilityDomain ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ai:Capability ;
            owl:onProperty skos:member ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty skos:member ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:CapabilityDomain ;
            owl:onProperty <http://schema.org/isPartOf> ],
        skos:Collection,
        nexus:CapabilityConcept ;
    skos:definition "A group of AI capabilities that are part of a capability taxonomy, organized under a domain" ;
    skos:inScheme nexus:ai_capability .

nexus:StakeholderGroup a owl:Class ;
    rdfs:label "StakeholderGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        skos:Collection ;
    skos:definition "An AI system stakeholder grouping." ;
    skos:inScheme nexus:ai_system .

nexus:detectsRiskConcept a owl:ObjectProperty ;
    rdfs:label "detectsRiskConcept" ;
    rdfs:domain airo:RiskControl ;
    rdfs:range airo:RiskConcept ;
    owl:inverseOf nexus:isDetectedBy ;
    skos:definition "The property airo:detectsRiskConcept indicates the control used for detecting risks, risk sources, consequences, and impacts." ;
    skos:exactMatch airo:detectsRiskConcept ;
    skos:inScheme nexus:ai_risk .

nexus:requiredByTask a owl:ObjectProperty ;
    rdfs:label "requiredByTask" ;
    rdfs:domain nexus:Entry ;
    rdfs:range linkml:Any ;
    owl:inverseOf nexus:requiresCapability ;
    skos:definition "Indicates that this entry is required to perform a specific AI task." ;
    skos:inScheme nexus:common .

airo:AISystem a owl:Class ;
    rdfs:label "AiSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasEuAiSystemType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:isDevelopedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AIDeveloper ;
            owl:onProperty airo:isDevelopedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:BaseAi ;
            owl:onProperty nexus:isComposedOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:isComposedOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Risk ;
            owl:onProperty nexus:hasRelatedRisk ],
        [ a owl:Restriction ;
            owl:allValuesFrom ai:Capability ;
            owl:onProperty tech:hasCapability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasPurpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AISubject ;
            owl:onProperty airo:hasAISubject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tech:hasCapability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasStakeholder ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AIUser ;
            owl:onProperty airo:hasAiUser ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:EuAiRiskCategory ;
            owl:onProperty nexus:hasEuRiskCategory ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasEuRiskCategory ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Purpose ;
            owl:onProperty airo:hasPurpose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:isAppliedWithinDomain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:isDeployedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasRelatedRisk ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Domain ;
            owl:onProperty airo:isAppliedWithinDomain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:isDevelopedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasAiUser ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:LocalityOfUse ;
            owl:onProperty airo:isUsedWithinLocality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasEuRiskCategory ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Stakeholder ;
            owl:onProperty airo:hasStakeholder ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:isDeployedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:isUsedWithinLocality ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AIDeployer ;
            owl:onProperty airo:isDeployedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasAISubject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasEuAiSystemType ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:AiSystemType ;
            owl:onProperty nexus:hasEuAiSystemType ],
        nexus:BaseAi,
        nexus:Entry ;
    skos:definition "A compound AI System composed of one or more AI capablities. ChatGPT is an example of an AI system which deploys multiple GPT AI models." ;
    skos:exactMatch nexus:AiSystem ;
    skos:inScheme nexus:ai_system .

airo:Domain a owl:Class ;
    rdfs:label "Domain" ;
    rdfs:subClassOf nexus:Entry ;
    skos:definition "An area, sector, or industry that is associated with economic activities." ;
    skos:exactMatch nexus:Domain ;
    skos:inScheme nexus:ai_system .

airo:Purpose a owl:Class ;
    rdfs:label "Purpose" ;
    rdfs:subClassOf nexus:Entry ;
    skos:definition "The end goal for which an entity is used or an action is taken." ;
    skos:exactMatch nexus:Purpose ;
    skos:inScheme nexus:ai_system .

dpv:Obligation a owl:Class ;
    rdfs:label "Obligation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        nexus:ControlActivityObligation,
        dpv:Rule ;
    skos:definition "A rule describing an obligation for performing an activity" ;
    skos:exactMatch nexus:Obligation ;
    skos:inScheme nexus:common .

dpv:Permission a owl:Class ;
    rdfs:label "Permission" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        nexus:ControlActivityPermission,
        dpv:Rule ;
    skos:definition "A rule describing a permission to perform an activity" ;
    skos:exactMatch nexus:Permission ;
    skos:inScheme nexus:common .

dpv:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:isApplicableinLocality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:LocalityOfUse ;
            owl:onProperty nexus:isApplicableinLocality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        <http://schema.org/Thing>,
        nexus:LLMQuestionPolicy ;
    skos:definition "A guidance document outlining any of: procedures, plans, principles, decisions, intent, or protocols." ;
    skos:exactMatch nexus:Policy ;
    skos:inScheme nexus:common .

dpv:Principle a owl:Class ;
    rdfs:label "Principle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        nexus:Entry ;
    skos:definition "A representation of values or norms that must be taken into consideration when conducting activities." ;
    skos:exactMatch nexus:Principle ;
    skos:inScheme nexus:common .

dpv:Prohibition a owl:Class ;
    rdfs:label "Prohibition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        nexus:ControlActivityProhibition,
        dpv:Rule ;
    skos:definition "A rule describing a prohibition to perform an activity" ;
    skos:exactMatch nexus:Prohibition ;
    skos:inScheme nexus:common .

dqv:QualityMeasurement a owl:Class ;
    rdfs:label "AiEvalResult" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dqv:isMeasurementOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqv:Metric ;
            owl:onProperty dqv:isMeasurementOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqv:isMeasurementOf ],
        <http://schema.org/Statement>,
        <http://schema.org/Thing> ;
    skos:definition "The result of an evaluation for a specific AI model." ;
    skos:exactMatch nexus:AiEvalResult ;
    skos:inScheme nexus:ai_eval .

<http://schema.org/Dataset> a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:isProvidedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AIProvider ;
            owl:onProperty airo:isProvidedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:isProvidedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:License ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        <http://schema.org/Thing> ;
    skos:definition "A body of structured information describing some topic(s) of interest." ;
    skos:exactMatch nexus:Dataset ;
    skos:inScheme nexus:common .

nexus:AIUC1EvidenceCategory a owl:Class ;
    rdfs:label "AIUC1EvidenceCategory" ;
    skos:definition "AIUC1 Evidence Category" ;
    skos:inScheme nexus:ai_aiuc ;
    linkml:permissible_values <https://w3id.org/ai-atlas-nexus/AIUC1EvidenceCategory#LEGAL_POLICIES>,
        <https://w3id.org/ai-atlas-nexus/AIUC1EvidenceCategory#OPERATIONAL_PRACTICES>,
        <https://w3id.org/ai-atlas-nexus/AIUC1EvidenceCategory#TECHNICAL_IMPLEMENTATION>,
        <https://w3id.org/ai-atlas-nexus/AIUC1EvidenceCategory#THIRD_PARTY_EVALS> .

nexus:CapabilityDomain a owl:Class ;
    rdfs:label "CapabilityDomain" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nexus:CapabilityGroup ;
            owl:onProperty nexus:hasPart ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasPart ],
        skos:Collection,
        nexus:CapabilityConcept ;
    skos:definition "A high-level domain of AI capabilities (e.g., Language, Reasoning, Knowledge)" ;
    skos:exactMatch nexus:CapabilityDomain ;
    skos:inScheme nexus:ai_capability .

nexus:Control a owl:Class ;
    rdfs:label "Control" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom airo:LocalityOfUse ;
            owl:onProperty nexus:isApplicableinLocality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:isApplicableinLocality ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty nexus:hasExternalReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasExternalReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        <http://schema.org/Thing>,
        airo:RiskControl ;
    skos:definition "A measure that maintains and/or modifies" ;
    skos:exactMatch nexus:Control ;
    skos:inScheme nexus:common .

nexus:author a owl:DatatypeProperty .

nexus:evaluationresultrecord a owl:Class ;
    rdfs:label "EvaluationResultRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:evaluation_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:evaluation_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasSourceData ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:evaluation_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasScoreDetails ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:hasSourceData ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasScoreDetails ],
        [ a owl:Restriction ;
