        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        <http://schema.org/Thing> ;
    skos:definition "A concept" ;
    skos:exactMatch nexus:Concept ;
    skos:inScheme nexus:common .

<http://schema.org/isPartOf> a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "belongsToDomain",
        "isDefinedByTaxonomy",
        "isDefinedByVocabulary",
        "isPartOf" ;
    rdfs:range skos:ConceptScheme,
        linkml:Any ;
