    skos:exactMatch nexus:License ;
    skos:inScheme nexus:common .

dpv:Rule a owl:Class ;
    rdfs:label "Rule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom dpv:Rule ;
            owl:onProperty dpv:hasRule ],
        [ owl:unionOf ( nexus:AttributeConditionRule nexus:ControlActivity dpv:Obligation dpv:Permission dpv:Prohibition dpv:Recommendation nexus:Requirement ) ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dpv:hasRule ],
        [ a owl:Restriction ;
