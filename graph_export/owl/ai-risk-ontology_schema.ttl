        <https://w3id.org/ai-atlas-nexus/AiSystemType#PROHIBITED>,
        <https://w3id.org/ai-atlas-nexus/AiSystemType#SCIENTIFIC_RD> .

nexus:LifecycleStatus a owl:Class ;
    rdfs:label "LifecycleStatus" ;
    rdfs:seeAlso adms-status:1.0,
        <https://semiceu.github.io/ADMS/releases/2.00/>,
        <https://sparontologies.github.io/pso/current/pso.html> ;
    skos:definition "Editorial / publication state of a catalogued entity. Permissible values align to the ADMS-status codelist where one exists; otherwise drawn from PSO vocabulary, and failing that, minted in this nexus namespace." ;
    skos:inScheme nexus:common ;
    linkml:permissible_values adms-status:Completed,
        adms-status:Deprecated,
        adms-status:UnderDevelopment,
        adms-status:Withdrawn,
        pso:under-review,
        <https://w3id.org/ai-atlas-nexus/LifecycleStatus#SUPERSEDED> .

airo:Stakeholder a owl:Class ;
