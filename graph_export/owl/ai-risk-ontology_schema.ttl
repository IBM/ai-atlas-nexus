            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasLicense ],
        <http://schema.org/Thing> ;
    skos:altLabel "ExternalReference" ;
    skos:definition "Documented information about a concept or other topic(s) of interest." ;
    skos:exactMatch nexus:Documentation ;
    skos:inScheme nexus:common .

airo:RiskConcept a owl:Class ;
    rdfs:label "RiskConcept" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
