    skos:definition "A collection of terms, with their definitions and relationships.",
        "A hierachical taxonomy of concepts, with their definitions and relationships.",
        "A taxonomy of AI capabilities describing the abilities of AI systems." ;
    skos:exactMatch nexus:CapabilityTaxonomy,
        nexus:Taxonomy,
        nexus:Vocabulary ;
    skos:inScheme nexus:ai_capability,
        nexus:common .

