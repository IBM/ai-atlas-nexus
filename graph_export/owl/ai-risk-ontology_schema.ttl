            owl:onProperty nexus:type ],
        [ owl:unionOf ( nexus:Adapter airo:AISystem airo:AiCapability ai:Capability dpv:Certification airo:Domain ai:Capability airo:LocalityOfUse dpv:Principle airo:Purpose airo:Risk nexus:Term ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Any ;
            owl:onProperty nexus:implementedByAdapter ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:requiredByTask ],
        [ a owl:Restriction ;
            owl:allValuesFrom dpv:Rule ;
            owl:onProperty dpv:hasRule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasExternalReference ],
        <http://schema.org/Thing> ;
    skos:definition "An entry and its definitions." ;
    skos:exactMatch nexus:Entry ;
    skos:inScheme nexus:common .

<http://schema.org/version> a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition "The version of the entity embodied by a specified resource." ;
    skos:inScheme nexus:common .

nexus:hasRelatedRisk a owl:ObjectProperty ;
    rdfs:label "hasRelatedRisk" ;
    rdfs:domain linkml:Any ;
    rdfs:range linkml:Any ;
    skos:definition "A relationship where an entity relates to a risk" ;
    skos:inScheme nexus:common .

ai:Capability a owl:Class ;
    rdfs:label "Capability",
        "LLMIntrinsic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nexus:Adapter ;
            owl:onProperty nexus:implementedByAdapter ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ai:Capability ;
            owl:onProperty nexus:implementsCapability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasRelatedRisk ],
        [ a owl:Restriction ;
            owl:allValuesFrom ai:Capability ;
            owl:onProperty tech:hasCapability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasRelatedTerm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:isPartOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:hasAdapter ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:CapabilityGroup ;
            owl:onProperty nexus:isPartOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:requiredByTask ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nexus:isPartOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:implementedByAdapter ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:RiskConcept ;
            owl:onProperty nexus:hasRelatedRisk ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:Documentation ;
            owl:onProperty airo:hasDocumentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:ConceptScheme ;
            owl:onProperty <http://schema.org/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom airo:AiCapability ;
            owl:onProperty nexus:requiredByTask ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nexus:implementsCapability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty tech:hasCapability ],
        [ a owl:Restriction ;
            owl:allValuesFrom nexus:Adapter ;
            owl:onProperty nexus:hasAdapter ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( airo:RiskConcept nexus:Term ) ] nexus:Term ) ] ;
            owl:onProperty nexus:hasRelatedTerm ],
        nexus:CapabilityConcept,
        nexus:Entry ;
    skos:broadMatch tech:Capability ;
    skos:definition "A capability that can be invoked through a well-defined API that is reasonably stable and independent of how the LLM intrinsic itself is implemented.",
        """A specific AI capability or ability, such as reading comprehension, logical reasoning, or code generation. Aligned with the W3C DPV AI extension dpv-ai:Capability, representing what an AI technology is capable of achieving or providing.
Capabilities are distinct from: (1) the intended purpose for which the technology is designed, (2) the actual tasks performed in a specific deployment context, and (3) the technical implementation mechanisms (intrinsics, adapters) that enable the capability.""" ;
    skos:exactMatch nexus:Capability,
        nexus:LLMIntrinsic ;
    skos:inScheme nexus:ai_capability,
        nexus:ai_intrinsic .

airo:Documentation a owl:Class ;
    rdfs:label "Documentation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nexus:Term ;
            owl:onProperty nexus:isCategorizedAs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty airo:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nexus:author ],
